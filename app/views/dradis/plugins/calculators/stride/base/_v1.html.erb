<div data-behavior="stride-calc" class="stride-calculator">
  <div class="row g-4 mt-1">
    <div class="col-lg-6">
      <%= render 'dradis/plugins/calculators/stride/base/fields' %>
    </div>

    <div class="col-lg-6 stride-results-column">
      <label for="stride_fields" class="form-label">Result</label>
      <%= text_area_tag :stride_fields, @issue_fields, rows: 20, class: 'form-control stride-output-textarea', data: { behavior: 'stride-result' } %>
    </div>
  </div>
</div>
