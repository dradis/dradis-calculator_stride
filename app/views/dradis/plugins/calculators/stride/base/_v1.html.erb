<div data-behavior="stride-calc">
  <div class="row mt-3">
    <div class="col-md-6">
      <div class="mb-4">
        <label class="form-label" for="stride-spoofing-select">Spoofing</label>
        <select id="stride-spoofing-select" class="form-select" data-field="STRIDE.Spoofing" data-combobox-config="no-combobox">
          <option value="" disabled selected>Select…</option>
          <option value="Yes">Yes</option>
          <option value="No">No</option>
        </select>
      </div>

      <div class="mb-4">
        <label class="form-label" for="stride-tampering-select">Tampering</label>
        <select id="stride-tampering-select" class="form-select" data-field="STRIDE.Tampering" data-combobox-config="no-combobox">
          <option value="" disabled selected>Select…</option>
          <option value="Yes">Yes</option>
          <option value="No">No</option>
        </select>
      </div>

      <div class="mb-4">
        <label class="form-label" for="stride-repudiation-select">Repudiation</label>
        <select id="stride-repudiation-select" class="form-select" data-field="STRIDE.Repudiation" data-combobox-config="no-combobox">
          <option value="" disabled selected>Select…</option>
          <option value="Yes">Yes</option>
          <option value="No">No</option>
        </select>
      </div>

      <div class="mb-4">
        <label class="form-label" for="stride-informationdisclosure-select">Information Disclosure</label>
        <select id="stride-informationdisclosure-select" class="form-select" data-field="STRIDE.InformationDisclosure" data-combobox-config="no-combobox">
          <option value="" disabled selected>Select…</option>
          <option value="Yes">Yes</option>
          <option value="No">No</option>
        </select>
      </div>

      <div class="mb-4">
        <label class="form-label" for="stride-denialofservice-select">Denial of Service</label>
        <select id="stride-denialofservice-select" class="form-select" data-field="STRIDE.DenialOfService" data-combobox-config="no-combobox">
          <option value="" disabled selected>Select…</option>
          <option value="Yes">Yes</option>
          <option value="No">No</option>
        </select>
      </div>

      <div class="mb-1">
        <label class="form-label" for="stride-elevationofprivilege-select">Elevation of Privilege</label>
        <select id="stride-elevationofprivilege-select" class="form-select" data-field="STRIDE.ElevationOfPrivilege" data-combobox-config="no-combobox">
          <option value="" disabled selected>Select…</option>
          <option value="Yes">Yes</option>
          <option value="No">No</option>
        </select>
      </div>
    </div>

    <div class="col-md-6 d-flex flex-column">
      <label for="stride_fields" class="form-label">Result</label>
      <%= text_area_tag :stride_fields, @issue_fields, class: 'form-control flex-grow-1', data: { behavior: 'stride-result' } %>
    </div>
  </div>
</div>
