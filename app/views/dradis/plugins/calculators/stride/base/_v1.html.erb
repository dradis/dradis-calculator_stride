<div data-behavior="stride-calc" class="stride-calculator">
  <div class="row g-4 mt-1">
    <div class="col-lg-6">
      <%= render 'dradis/plugins/calculators/stride/base/fields' %>
    </div>

    <div class="col-lg-6 stride-results-column">
      <div class="stride-results-panel">
        <h3 class="stride-section-title">Result</h3>

        <div class="stride-score-display">
          <span class="stride-score" aria-label="STRIDE">
            <%= safe_join(Dradis::Plugins::Calculators::STRIDE::V1::FIELDS.map do |field, options|
              content_tag :span, options[:label].first, class: ('text-black-50' unless @stride_values[field] == 'Yes'), data: { stride_letter: field }
            end) %>
          </span>
        </div>

        <div class="stride-dradis-output">
          <label class="stride-output-label">
            Dradis field output
            <span class="d-block">Copy this into Dradis to populate issue fields</span>
          </label>
          <%= text_area_tag :stride_fields, @issue_fields, rows: 20, class: 'form-control stride-output-textarea', readonly: true, data: { behavior: 'stride-result', source_url: stride_calculator.stride_source_path } %>
        </div>
      </div>
    </div>
  </div>
</div>
