(function () {
  function init() {
    const root = document.querySelector('[data-behavior~="stride-calc"]');
    if (!root) return;

    const result = root.querySelector('[data-behavior~="stride-result"]');
    if (!result) return;

    const switches = Array.from(root.querySelectorAll('[data-field^="STRIDE."]'));
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

    const post = (url, body) =>
      fetch(url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken
        },
        body: JSON.stringify(body)
      }).then((response) => {
        if (!response.ok) throw new Error(`STRIDE request failed: ${response.status}`);
        return response;
      });

    const updateScoreLetter = (field, value) => {
      const element = root.querySelector(`[data-stride-letter="${field}"]`);
      if (element) element.classList.toggle('text-black-50', value !== 'Yes');
    };

    const switchValues = () =>
      Object.fromEntries(
        switches.map((switchInput) => [switchInput.dataset.field, switchInput.checked ? 'Yes' : 'No'])
      );

    const updateSource = async () => {
      const response = await post(result.dataset.sourceUrl, { values: switchValues() });
      result.value = await response.text();
    };

    switches.forEach((switchInput) => {
      switchInput.addEventListener('change', () => {
        updateScoreLetter(switchInput.dataset.field, switchInput.checked ? 'Yes' : 'No');
        updateSource();
      });
    });
  }

  document.addEventListener('turbo:load', init);
  document.addEventListener('turbo:frame-load', init);
})();
